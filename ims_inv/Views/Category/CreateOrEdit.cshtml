@model ims_inv.Models.CategoryViewModel
@{
    ViewData["Title"] = (Model.Id == 0 ? "Create" : "Edit") + " Category";
    ViewData["ActivePage"] = "Category";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-sm btn-secondary shadow-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Category Details</h6>
            </div>
            <div class="card-body">
                <form asp-action="CreateOrEdit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Category Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Electronics" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ParentId" class="form-label">Parent Category</label>
                        <select asp-for="ParentId" class="form-select" asp-items="ViewBag.ParentId">
                            <option value="">-- No Parent (Root Category) --</option>
                        </select>
                        <span asp-validation-for="ParentId" class="text-danger"></span>
                        <div class="form-text">Choose a parent if you want this to be a sub-category.</div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> @(Model.Id == 0 ? "Save Category" : "Update Category")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow mb-4 border-left-info">
            <div class="card-body">
                <h5 class="text-info"><i class="bi bi-info-circle me-2"></i> Quick Tips</h5>
                <p class="small text-muted mt-3">
                    - **Root Categories**: Categories without a parent act as top-level containers.<br /><br />
                    - **Sub-Categories**: You can nest categories as deep as needed (e.g., Electronics -> Mobile Phones -> Smartphones).<br /><br />
                    - **Deletion**: You cannot delete a category that still contains sub-categories. Move or delete children first.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
