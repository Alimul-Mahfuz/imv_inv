@model ims_inv.Controllers.EditUnitConversionViewModel
@{
    ViewData["Title"] = $"Edit Unit Conversion";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
        <i class="bi bi-pencil-square me-2"></i>Edit Unit Conversion
    </h1>
</div>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Products</a></li>
        <li class="breadcrumb-item">
            <a asp-action="ProductConversions" asp-route-productId="@Model.ProductId">Unit Conversions</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Edit Conversion</li>
    </ol>
</nav>

<div class="row">
    <div class="col-lg-12">
        <!-- Conversion Info Card -->
        <div class="card shadow mb-4 border-left-info">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <div class="badge bg-info" style="font-size: 1rem; padding: 0.5rem 1rem;">
                            @Model.FromUnitSymbol
                        </div>
                    </div>
                    <div class="col">
                        <h5 class="mb-0">@Model.FromUnitName</h5>
                        <small class="text-muted">From Unit</small>
                    </div>
                    <div class="col-auto">
                        <i class="bi bi-arrow-right text-info" style="font-size: 1.5rem;"></i>
                    </div>
                    <div class="col">
                        <h5 class="mb-0">@Model.ToUnitName</h5>
                        <small class="text-muted">To Unit</small>
                    </div>
                    <div class="col-auto">
                        <div class="badge bg-info" style="font-size: 1rem; padding: 0.5rem 1rem;">
                            @Model.ToUnitSymbol
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit Form -->
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Update Conversion Factor</h6>
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-conversionId="@Model.ConversionId" 
                      asp-route-productId="@Model.ProductId" method="post">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Error!</strong> Please fix the errors below.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- From Unit (Read-only) -->
                    <div class="mb-3">
                        <label for="fromUnit" class="form-label">
                            <i class="bi bi-arrow-left me-2 text-primary"></i>
                            <strong>From Unit</strong>
                        </label>
                        <div class="input-group input-group-lg">
                            <input type="text" class="form-control" id="fromUnit" 
                                   value="@Model.FromUnitName (@Model.FromUnitSymbol)" disabled>
                            <span class="input-group-text text-muted">Read-only</span>
                        </div>
                    </div>

                    <!-- To Unit (Read-only) -->
                    <div class="mb-3">
                        <label for="toUnit" class="form-label">
                            <i class="bi bi-arrow-right me-2 text-success"></i>
                            <strong>To Unit</strong>
                        </label>
                        <div class="input-group input-group-lg">
                            <input type="text" class="form-control" id="toUnit" 
                                   value="@Model.ToUnitName (@Model.ToUnitSymbol)" disabled>
                            <span class="input-group-text text-muted">Read-only</span>
                        </div>
                    </div>

                    <!-- Conversion Factor -->
                    <div class="mb-4">
                        <label asp-for="ConversionFactor" class="form-label">
                            <i class="bi bi-calculator me-2 text-warning"></i>
                            <strong asp-for="ConversionFactor"></strong>
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text">1 @Model.FromUnitSymbol =</span>
                            <input asp-for="ConversionFactor" class="form-control" 
                                   type="number" step="0.0001" 
                                   aria-describedby="factorHelp">
                            <span class="input-group-text" id="targetUnitDisplay">@Model.ToUnitSymbol</span>
                        </div>
                        <span asp-validation-for="ConversionFactor" class="text-danger d-block mt-2"></span>
                        <div id="factorHelp" class="form-text mt-3">
                            <strong>Current Value:</strong> 
                            <code>@Model.ConversionFactor</code>
                        </div>
                    </div>

                    <!-- Preview -->
                    <div class="alert alert-light border" id="previewBox">
                        <strong>Preview:</strong>
                        <div id="previewText" class="mt-2">
                            <small class="text-muted">
                                1 @Model.FromUnitSymbol × @Model.ConversionFactor = <strong>@Model.ConversionFactor @Model.ToUnitSymbol</strong>
                            </small>
                        </div>
                    </div>

                    <!-- Change History -->
                    <div class="alert alert-info mb-4">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Note:</strong> Only the conversion factor can be edited. 
                        To change the units, delete this conversion and create a new one.
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="ProductConversions" asp-route-productId="@Model.ProductId" 
                           class="btn btn-secondary btn-lg">
                            <i class="bi bi-arrow-left me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-check-circle me-2"></i>Update Conversion
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Info Card -->
        <div class="card shadow mt-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="bi bi-lightbulb me-2"></i>Conversion Factor Guide
                </h6>
            </div>
            <div class="card-body">
                <h6>What is a Conversion Factor?</h6>
                <p>
                    The conversion factor is the multiplier used to convert from the "From Unit" to the "To Unit".
                </p>

                <div class="bg-light p-3 rounded mb-3">
                    <strong>Current Formula:</strong>
                    <div class="mt-2">
                        <code>1 @Model.FromUnitSymbol × [conversion factor] = [value in @Model.ToUnitSymbol]</code>
                    </div>
                </div>

                <h6>Common Patterns:</h6>
                <ul>
                    <li><strong>Upscaling:</strong> Converting to larger units (e.g., grams to kg) uses decimal (0.001)</li>
                    <li><strong>Downscaling:</strong> Converting to smaller units (e.g., kg to grams) uses whole numbers (1000)</li>
                    <li><strong>Counting:</strong> Converting to items uses whole numbers (e.g., dozen to pieces = 12)</li>
                </ul>

                <h6 class="mt-4">Examples:</h6>
                <table class="table table-sm table-light">
                    <thead>
                        <tr>
                            <th>From</th>
                            <th>To</th>
                            <th>Factor</th>
                            <th>Meaning</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>kg</td>
                            <td>grams</td>
                            <td><code>1000</code></td>
                            <td>1 kg = 1000 grams</td>
                        </tr>
                        <tr>
                            <td>grams</td>
                            <td>kg</td>
                            <td><code>0.001</code></td>
                            <td>1 gram = 0.001 kg</td>
                        </tr>
                        <tr>
                            <td>liter</td>
                            <td>ml</td>
                            <td><code>1000</code></td>
                            <td>1 liter = 1000 ml</td>
                        </tr>
                        <tr>
                            <td>dozen</td>
                            <td>pieces</td>
                            <td><code>12</code></td>
                            <td>1 dozen = 12 pieces</td>
                        </tr>
                    </tbody>
                </table>

                <div class="alert alert-warning mt-3 mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Decimal Support:</strong> You can use up to 4 decimal places (e.g., 2.5, 0.0001, 999999.9999)
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Update preview as user types the conversion factor
        document.getElementById('ConversionFactor').addEventListener('input', function() {
            const factor = this.value;
            const fromSymbol = '@Model.FromUnitSymbol';
            const toSymbol = '@Model.ToUnitSymbol';

            const previewText = document.getElementById('previewText');
            if (factor) {
                previewText.innerHTML = `1 ${fromSymbol} × ${factor} = <strong>${factor} ${toSymbol}</strong>`;
            }
        });
    </script>
}
