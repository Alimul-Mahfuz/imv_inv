@model IEnumerable<ims_inv.Models.StockMovement>
@{
    ViewData["Title"] = "Movement History";
    ViewData["ActivePage"] = "StockEntry";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Stock Movement History</h1>
    <a asp-action="Create" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> New Stock Entry
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Transaction Logs</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="movementTable" width="100%" cellspacing="0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Product</th>
                        <th>Warehouse</th>
                        <th>Type</th>
                        <th>Qty</th>
                        <th>Reason</th>
                        <th>Reference</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@item.Product?.Name</td>
                                <td>@item.Warehouse?.Name</td>
                                <td>
                                    @if (item.MovementType == "IN")
                                    {
                                        <span class="badge bg-success"><i class="bi bi-arrow-down-left me-1"></i> IN</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-arrow-up-right me-1"></i> OUT</span>
                                    }
                                </td>
                                <td class="fw-bold">@item.Quantity</td>
                                <td>@item.Reason</td>
                                <td><small class="text-muted">@item.ReferenceNumber</small></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No stock movements recorded yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
