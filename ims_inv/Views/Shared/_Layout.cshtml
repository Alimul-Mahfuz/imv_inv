@using X.PagedList.Mvc.Core
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            .pagination {
                display: flex;
                list-style: none;
                gap: 5px;
            }
    </style>
</head>
<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="wrapper">
            <!-- Sidebar -->
            <nav id="sidebar">
                <div class="sidebar-header">
                    <h3>IMS</h3>
                </div>

                <ul class="list-unstyled components">
                    <p>Core</p>
                    <li class="@(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")">
                        <a asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a>
                    </li>
                    <li class="@(ViewData["ActivePage"]?.ToString() == "Warehouse" ? "active" : "")">
                        <a asp-controller="Warehouse" asp-action="Index"><i class="bi bi-house-door me-2"></i> Warehouse</a>
                    </li>
                    <li class="@(ViewData["ActivePage"]?.ToString() == "Supplier" ? "active" : "")">
                        <a asp-controller="Supplier" asp-action="Index"><i class="bi bi-truck me-2"></i> Suppliers</a>
                    </li>
                    <li class="@(ViewData["ActivePage"]?.ToString() == "Category" ? "active" : "")">
                        <a asp-controller="Category" asp-action="Index"><i class="bi bi-tags me-2"></i> Categories</a>
                    </li>
                    <li class="@(ViewData["ActivePage"]?.ToString() == "Unit" ? "active" : "")">
                        <a asp-controller="Unit" asp-action="Index"><i class="bi bi-rulers me-2"></i> Units</a>
                    </li>
                    <li class="@(ViewData["ActivePage"]?.ToString() == "Product" ? "active" : "")">
                        <a asp-controller="Product" asp-action="Index"><i class="bi bi-box-seam me-2"></i> Products</a>
                    </li>
                    <li class="@(ViewData["ActivePage"]?.ToString() == "Inventory" ? "active" : "")">
                        <a asp-controller="Inventory" asp-action="Index"><i class="bi bi-boxes me-2"></i> Inventory</a>
                    </li>
                    <li class="@(ViewData["ActivePage"]?.ToString() == "StockEntry" ? "active" : "")">
                        <a asp-controller="StockMovement" asp-action="Index"><i class="bi bi-arrow-left-right me-2"></i> Stock Entry</a>
                    </li>
                    <li class="@(ViewData["ActivePage"]?.ToString() == "Privacy" ? "active" : "")">
                        <a asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield-lock me-2"></i> Privacy</a>
                    </li>
                    <li>
                        <a href="#"><i class="bi bi-people me-2"></i> Users</a>
                    </li>
                    <li>
                        <a href="#"><i class="bi bi-gear me-2"></i> Settings</a>
                    </li>
                </ul>
            </nav>

            <!-- Overlay for mobile -->
            <div class="overlay"></div>

            <!-- Page Content -->
            <div id="content" class="d-flex flex-column min-vh-100">
                <nav class="navbar navbar-expand-lg navbar-light navbar-dashboard mb-4 rounded">
                    <div class="container-fluid">
                        <button type="button" id="sidebarCollapse" class="btn btn-primary">
                            <i class="bi bi-list"></i>
                        </button>

                        <div class="ms-auto d-flex align-items-center">
                            <span class="me-3 d-none d-md-inline">Welcome, <strong>@User.Identity.Name</strong></span>
                            <div class="dropdown">
                                <a class="btn btn-outline-secondary dropdown-toggle" href="#" role="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item" href="#">Profile</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </nav>

                <div class="container-fluid flex-grow-1">
                    @RenderBody()
                </div>

                <footer class="footer border-top text-muted py-3 mt-4">
                    <div class="container-fluid d-flex justify-content-between align-items-center">
                        <span class="small">&copy; @DateTime.UtcNow.Year - IMS Inventory Management System</span>
                        <span class="small"><a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">Privacy</a></span>
                    </div>
                </footer>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column min-vh-100">
            <div class="container flex-grow-1 py-4">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
            <footer class="footer border-top text-muted py-3 mt-auto">
                <div class="container text-center small">
                    &copy; @DateTime.UtcNow.Year - IMS Inventory Management System - <a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">Privacy</a>
                </div>
            </footer>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $('#sidebarCollapse, .overlay').on('click', function () {
                $('#sidebar').toggleClass('active');
                $('.overlay').toggleClass('active');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
