@model ims_inv.Models.StockTransferViewModel
@{
    ViewData["Title"] = "Transfer Stock";
    ViewData["ActivePage"] = "Inventory";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Warehouse Stock Transfer</h1>
    <a asp-action="Index" class="btn btn-sm btn-secondary shadow-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Inventory
    </a>
</div>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
    <li class="breadcrumb-item"><a asp-action="Index">Inventory</a></li>
    <li class="breadcrumb-item active" aria-current="page">Transfer Stock</li>
  </ol>
</nav>

<div class="row">
    <div class="col-lg-7">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Transfer Stock Between Warehouses</h6>
            </div>
            <div class="card-body">
                <form asp-action="Transfer" method="post" id="transferForm">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All" class="alert alert-danger mb-3 @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="ProductId" class="form-label fw-bold">Product</label>
                        <select asp-for="ProductId" class="form-select" asp-items="ViewBag.Products" required onchange="onSelectionChange()">
                            <option value="">-- Select Product --</option>
                        </select>
                        <span asp-validation-for="ProductId" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="FromWarehouseId" class="form-label fw-bold">Source Warehouse (From)</label>
                            <select asp-for="FromWarehouseId" class="form-select" asp-items="ViewBag.FromWarehouses" required onchange="onSelectionChange()">
                                <option value="">-- Select Source Warehouse --</option>
                            </select>
                            <div class="mt-1 small text-muted" id="sourceStockInfo">
                                Available Stock: <strong id="availableStockDisplay" class="text-primary">-</strong>
                            </div>
                            <span asp-validation-for="FromWarehouseId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ToWarehouseId" class="form-label fw-bold">Destination Warehouse (To)</label>
                            <select asp-for="ToWarehouseId" class="form-select" asp-items="ViewBag.ToWarehouses" required>
                                <option value="">-- Select Destination Warehouse --</option>
                            </select>
                            <span asp-validation-for="ToWarehouseId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Quantity" class="form-label fw-bold">Quantity to Transfer</label>
                            <input asp-for="Quantity" type="number" step="0.0001" min="0.0001" class="form-control" placeholder="e.g. 50" required />
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EntryUnitId" class="form-label fw-bold">Unit</label>
                            <select asp-for="EntryUnitId" class="form-select" id="unitSelect" asp-items="ViewBag.Units">
                                <option value="">-- Base Unit / Select Unit --</option>
                            </select>
                            <span asp-validation-for="EntryUnitId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ReferenceNumber" class="form-label fw-bold">Transfer Reference #</label>
                        <input asp-for="ReferenceNumber" class="form-control" placeholder="e.g. TR-2026-001 or Dispatch Note #" />
                        <span asp-validation-for="ReferenceNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label fw-bold">Notes / Reason</label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Optional transfer comments, transport details, etc."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-arrow-left-right me-1"></i> Confirm Transfer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow mb-4 border-left-primary">
            <div class="card-body">
                <h5 class="text-primary"><i class="bi bi-info-circle me-2"></i> Stock Transfer Rules</h5>
                <ul class="small text-muted mt-3 mb-0 ps-3">
                    <li>Stock transfers operate as <strong>atomic two-phase transactions</strong>: stock is deducted from the source warehouse and deposited into the destination warehouse simultaneously.</li>
                    <li class="mt-2">The source warehouse and destination warehouse must be different.</li>
                    <li class="mt-2">You cannot transfer more stock than the available balance in the source warehouse.</li>
                    <li class="mt-2">Two audit entries (1 OUT and 1 IN) will be automatically written to the movement ledger.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function onSelectionChange() {
            const productId = document.getElementById('ProductId').value;
            const fromWarehouseId = document.getElementById('FromWarehouseId').value;
            const stockDisplay = document.getElementById('availableStockDisplay');

            if (!productId || !fromWarehouseId) {
                stockDisplay.textContent = '-';
                return;
            }

            fetch(`/Inventory/GetCurrentStock?productId=${productId}&warehouseId=${fromWarehouseId}`)
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        stockDisplay.textContent = `${data.quantity} ${data.unitSymbol}`;
                    } else {
                        stockDisplay.textContent = '0';
                    }
                })
                .catch(() => {
                    stockDisplay.textContent = '-';
                });
        }

        document.addEventListener('DOMContentLoaded', onSelectionChange);
    </script>
}
