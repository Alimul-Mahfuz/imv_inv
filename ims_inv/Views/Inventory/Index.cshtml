@model IEnumerable<ims_inv.Models.Inventory>
@{
    ViewData["Title"] = "Inventory Management";
    ViewData["ActivePage"] = "Inventory";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Inventory Management</h1>
    <div class="btn-group shadow-sm">
        <a asp-action="Adjustment" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-arrow-left-right me-1"></i> Stock Adjustment
        </a>
        <a asp-action="Transfer" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-truck-flatbed me-1"></i> Transfer Stock
        </a>
    </div>
</div>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
    <li class="breadcrumb-item active" aria-current="page">Inventory</li>
  </ol>
</nav>

<div class="row">
    <!-- Quick Stats Cards -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Stock Items</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Sum(i => i.Quantity)</div>
                    </div>
                    <div class="col-auto">
                        <i class="bi bi-box-fill fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Low Stock Alerts</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count(i => i.Quantity <= (i.ReorderLevel ?? 0))</div>
                    </div>
                    <div class="col-auto">
                        <i class="bi bi-exclamation-triangle-fill fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Current Stock Levels</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="inventoryTable" width="100%" cellspacing="0">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Current Quantity</th>
                        <th>Reorder Level</th>
                        <th>Status</th>
                        <th>Last Updated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var isLowStock = item.Quantity <= (item.ReorderLevel ?? 0);
                            <tr>
                                <td><strong>@(item.Product?.Name ?? "N/A")</strong><br/><small class="text-muted">@(item.Product?.SKU)</small></td>
                                <td>@item.Quantity</td>
                                <td>@(item.ReorderLevel?.ToString() ?? "Not Set")</td>
                                <td>
                                    @if (isLowStock)
                                    {
                                        <span class="badge bg-danger">Low Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Healthy</span>
                                    }
                                </td>
                                <td>@(item.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? item.CreatedAt.ToString("yyyy-MM-dd HH:mm"))</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="StockCard" asp-route-productId="@item.ProductId" class="btn btn-sm btn-outline-info" title="View Stock Card">
                                            <i class="bi bi-card-list"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit Levels">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">No inventory records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
