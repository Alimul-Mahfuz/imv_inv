@model ims_inv.Models.EditReorderSettingsViewModel
@{
    ViewData["Title"] = "Edit Reorder Levels";
    ViewData["ActivePage"] = "Inventory";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Edit Inventory Settings</h1>
    <a asp-action="Index" class="btn btn-sm btn-secondary shadow-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Inventory
    </a>
</div>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
    <li class="breadcrumb-item"><a asp-action="Index">Inventory</a></li>
    <li class="breadcrumb-item active" aria-current="page">Edit Levels (@Model.ProductName - @Model.WarehouseName)</li>
  </ol>
</nav>

<div class="row">
    <div class="col-lg-6">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Reorder & Stock Thresholds</h6>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ProductId" />
                    <input type="hidden" asp-for="WarehouseId" />

                    <div asp-validation-summary="All" class="alert alert-danger mb-3 @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Product</label>
                        <input type="text" class="form-control bg-light" value="@Model.ProductName (@Model.ProductSKU)" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Warehouse</label>
                        <input type="text" class="form-control bg-light" value="@Model.WarehouseName" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Current Stock</label>
                        <input type="text" class="form-control bg-light" value="@Model.CurrentQuantity.ToString("G29") @Model.UnitSymbol" readonly />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="ReorderLevel" class="form-label fw-bold">Reorder Level (@Model.UnitSymbol)</label>
                            <input asp-for="ReorderLevel" type="number" step="0.0001" min="0" class="form-control" placeholder="e.g. 10" />
                            <small class="text-muted">Threshold triggering Low Stock alert</small>
                            <span asp-validation-for="ReorderLevel" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ReorderQuantity" class="form-label fw-bold">Reorder Quantity (@Model.UnitSymbol)</label>
                            <input asp-for="ReorderQuantity" type="number" step="0.0001" min="0" class="form-control" placeholder="e.g. 50" />
                            <small class="text-muted">Recommended replenishment qty</small>
                            <span asp-validation-for="ReorderQuantity" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow mb-4 border-left-info">
            <div class="card-body">
                <h5 class="text-info"><i class="bi bi-info-circle me-2"></i> About Reorder Thresholds</h5>
                <ul class="small text-muted mt-3 mb-0 ps-3">
                    <li><strong>Reorder Level:</strong> When available stock at this warehouse drops to or below this amount, the item will trigger a <strong>Low Stock Alert</strong> on the dashboard and inventory list.</li>
                    <li class="mt-2"><strong>Reorder Quantity:</strong> The suggested purchase / replenishment order quantity when creating purchase orders for this warehouse.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
